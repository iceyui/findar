# Host and port for uvicorn
HOST=0.0.0.0
PORT=9001

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Auth token validation
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional access restriction after token validation
# ALLOWED_AUTH_EMAILS=admin@vanila.id,finance@vanila.id
# ALLOWED_AUTH_DOMAINS=vanila.id

# Cloudflare Turnstile secret key (for login form protection)
# Leave empty to disable Turnstile verification (dev mode)
# TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Optional cleanup TTL in seconds
CLEANUP_TTL_SECONDS=3600

# Optional cleanup interval in seconds
CLEANUP_INTERVAL_SECONDS=3600
