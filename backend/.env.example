# Host and port for uvicorn
HOST=0.0.0.0
PORT=9001

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Auth token validation
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional access restriction after token validation
# ALLOWED_AUTH_EMAILS=admin@iceyuki.com,finance@iceyuki.com
# ALLOWED_AUTH_DOMAINS=iceyuki.com

# Optional cleanup TTL in seconds
CLEANUP_TTL_SECONDS=3600

# Optional cleanup interval in seconds
CLEANUP_INTERVAL_SECONDS=3600
