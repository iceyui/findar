# Host and port for the API server
HOST=0.0.0.0
PORT=9001

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Auth token validation
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional access restriction after token validation
# ALLOWED_AUTH_EMAILS=admin@vanila.id,finance@vanila.id
# ALLOWED_AUTH_DOMAINS=vanila.id

# Cloudflare Turnstile secret key (for login form protection)
# Kosongkan untuk menonaktifkan verifikasi (mode dev)
TURNSTILE_SECRET_KEY=

# Optional cleanup TTL in seconds
CLEANUP_TTL_SECONDS=3600

# Optional cleanup interval in seconds
CLEANUP_INTERVAL_SECONDS=3600

# Hard deadline for a single matcher run (seconds)
PROCESS_TIMEOUT_SECONDS=600

# Fail-fast guards: abort the search when it explores more nodes than this
# budget, and stop early when result rows exceed this cap.
SEARCH_NODE_BUDGET=200000000
MAX_RESULT_ROWS=250000

# XLSX zip-bomb guard limits
MAX_XLSX_UNCOMPRESSED_BYTES=104857600
MAX_XLSX_ENTRY_BYTES=52428800
MAX_XLSX_ENTRIES=1000
