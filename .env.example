# Frontend build-time variables (used by docker-compose build args)
# VITE_* variables are baked into the static bundle at build time.
VITE_API_BASE=/
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Isi dari dashboard Cloudflare Turnstile. Kosongkan untuk menyembunyikan widget (mode dev).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...
